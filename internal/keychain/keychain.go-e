// Package keychain tells whether processes can reach the macOS login
// keychain (docs/SPEC.md §3.1). A server started from an SSH login runs in
// that login's security session, and so does every session under it: the
// keychain refuses them ("Interaction with the Security Server is not
// allowed"), so gh's keyring token reads as invalid and git's osxkeychain
// helper fails. Nothing here reads a secret. On Linux every check is a
// no-op.
package keychain

import (
	"context"
	"os/exec"
	"strings"
	"time"

	"github.com/theclifmeister/terminatr/internal/proto"
)

// sshVars are the variables sshd sets in a login's environment.
var sshVars = []string{"SSH_CONNECTION", "SSH_TTY", "SSH_CLIENT"}

// OverSSH reports whether getenv's environment is an SSH login's.
func OverSSH(getenv func(string) string) bool {
	for _, v := range sshVars {
		if getenv(v) != "" {
			return true
		}
	}
	return false
}

// Fix is what to do about a server whose sessions can't reach the
// keychain.
const Fix = "tm server restart, which starts it in the desktop's session through launchd " +
	"(someone must be logged in at the Mac; the screen can stay locked)"

// StartWarning is the warning for starting a server from getenv's
// environment on goos without launchd (--no-launchd, TERMINATR_LAUNCHD=off),
// or "" when there is nothing to warn about.
func StartWarning(goos string, getenv func(string) string) string {
	if goos != "darwin" || !OverSSH(getenv) {
		return ""
	}
	return "warning: the server was started over SSH without launchd, so its sessions can't use the keychain " +
		"(the PR CLI's login, git credential helpers); " + Fix
}

// Runner runs a program and returns its combined, trimmed output.
type Runner func(name string, args ...string) (string, error)

// Run is the Runner Probe uses on the real system.
func Run(name string, args ...string) (string, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	out, err := exec.CommandContext(ctx, name, args...).CombinedOutput()
	return strings.TrimSpace(string(out)), err
}

// Probe checks whether this process, and so its children, can reach the
// login keychain on goos. It asks launchd which kind of session the
// process is in (Aqua is the desktop's; an SSH login is Background or
// StandardIO) and whether the login keychain's settings can be read, which
// needs the security server but no secret.
func Probe(goos string, getenv func(string) string, run Runner) proto.KeychainStatus {
	st := proto.KeychainStatus{OverSSH: OverSSH(getenv)}
	if goos != "darwin" {
		return st
	}
	st.Checked = true
	sess, err := run("launchctl", "managername")
	if err != nil {
		st.Detail = "launchctl managername: " + firstLine(orErr(sess, err))
		return st
	}
	st.Session = firstLine(sess)
	if st.Session != "Aqua" {
		st.Detail = "the server runs in a " + st.Session + " session, not the desktop's (Aqua)"
		if st.OverSSH {
			st.Detail += "; it was started over SSH"
		}
		return st
	}
	if out, err := run("security", "show-keychain-info", "login.keychain"); err != nil {
		st.Detail = "the login keychain can't be reached: " + firstLine(orErr(out, err))
		return st
	}
	st.OK = true
	st.Detail = "the login keychain is reachable (Aqua session)"
	return st
}

func orErr(out string, err error) string {
	if strings.TrimSpace(out) != "" {
		return out
	}
	return err.Error()
}

func firstLine(s string) string {
	s, _, _ = strings.Cut(strings.TrimSpace(s), "\n")
	return s
}
